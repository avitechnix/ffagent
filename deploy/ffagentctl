#!/usr/bin/env bash
# ffagentctl — run ffagent with the installed service's credentials and
# settings, and manage the watcher.
#
#   sudo ffagentctl analyze | matchup | lineup | waivers | trades | free-agents --pos RB
#   sudo ffagentctl secrets set      # refresh ESPN cookies (hidden input)
#   sudo ffagentctl secrets set email  # replace the Gmail app password
#   sudo ffagentctl secrets set anthropic  # Anthropic API key for questions
#   sudo ffagentctl secrets check
#   sudo ffagentctl email-test       # send a test email, check reply reading
#   sudo ffagentctl mode apply       # watcher emails moves for your approval
#   sudo ffagentctl mode dry-run     # watcher only logs what it would propose
#   sudo ffagentctl status | logs
#   sudo ffagentctl update           # pull the latest code and reinstall
#   sudo ffagentctl auto-update on|off   # weekly update (Tuesdays)
#
# Commands run as the unprivileged ffagent user in a transient systemd unit
# that receives the decrypted vault passphrase the same way the service does,
# so the passphrase is never shown or written in plaintext.
set -euo pipefail

CRED=/etc/credstore.encrypted/ffagent-passphrase
ENVFILE=/etc/ffagent/watch.env
UNIT=ffagent-watch.service

die() { echo "ffagentctl: $*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "run with sudo"
[[ $# -gt 0 ]] || { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

case "$1" in
  mode)
    case "${2:-}" in
      apply)   echo 'FFAGENT_WATCH_FLAGS=--apply' > "$ENVFILE" ;;
      dry-run) echo 'FFAGENT_WATCH_FLAGS=' > "$ENVFILE" ;;
      *) die "usage: ffagentctl mode apply|dry-run" ;;
    esac
    chmod 0644 "$ENVFILE"
    systemctl restart "$UNIT"
    echo "watcher restarted in ${2} mode"
    exit 0 ;;
  update)
    SRC=$(cat /etc/ffagent/source 2>/dev/null || true)
    [[ -n $SRC && -d $SRC/.git ]] || die "don't know where the source is; cd into your ffagent checkout and run: sudo ./deploy/install.sh"
    owner=$(stat -c %U "$SRC")
    asowner=(); [[ $owner != root ]] && asowner=(sudo -u "$owner" --)
    before=$("${asowner[@]}" git -C "$SRC" rev-parse HEAD)
    "${asowner[@]}" git -C "$SRC" pull --ff-only --quiet || die "git pull failed (local changes in $SRC?); nothing was changed"
    after=$("${asowner[@]}" git -C "$SRC" rev-parse HEAD)
    if [[ $before == "$after" ]]; then
      echo "ffagent is up to date ($(git -C "$SRC" log -1 --format=%h))"
      exit 0
    fi
    echo "Updating ffagent:"
    "${asowner[@]}" git -C "$SRC" log --format='  %h %s' "$before..$after" | head -20
    mode=dry-run; grep -q -- --apply "$ENVFILE" 2>/dev/null && mode=apply
    MODE=$mode FFAGENT_UPDATE=1 exec "$SRC/deploy/install.sh" </dev/null ;;
  auto-update)
    case "${2:-}" in
      on)  systemctl enable --now ffagent-update.timer && echo "weekly updates on (Tuesdays); next: $(systemctl show -p NextElapseUSecRealtime --value ffagent-update.timer)" ;;
      off) systemctl disable --now ffagent-update.timer && echo "weekly updates off" ;;
      *) die "usage: ffagentctl auto-update on|off" ;;
    esac
    exit 0 ;;
  status) exec systemctl status "$UNIT" --no-pager ;;
  logs)   shift; exec journalctl -u "$UNIT" --no-pager -n 200 "$@" ;;
esac

for a in "$@"; do
  [[ "$a" == "--apply" ]] && systemctl is-active --quiet "$UNIT" &&
    die "the watcher is running and holds the change lock; use 'ffagentctl mode apply', or stop it first (systemctl stop $UNIT)"
done

io=--pipe
[[ -t 0 && -t 1 ]] && io=--pty
exec systemd-run --quiet --wait --collect "$io" --service-type=exec \
  -p User=ffagent -p Group=ffagent \
  -p "LoadCredentialEncrypted=ffagent-passphrase:$CRED" \
  -p StateDirectory=ffagent -p StateDirectoryMode=0700 -p UMask=0077 \
  -p LimitCORE=0 -p NoNewPrivileges=yes -p ProtectSystem=strict -p ProtectHome=yes -p PrivateTmp=yes \
  -E HOME=/var/lib/ffagent \
  -E FFAGENT_CONFIG=/etc/ffagent/config.json \
  -E FFAGENT_VAULT=/var/lib/ffagent/secrets.vault \
  /usr/local/bin/ffagent "$@"
